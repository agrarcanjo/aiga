# Modo de execução
NODE_ENV=development

# Observabilidade (sobrescreve nivel salvo no boot — ver Configuracoes > Ambiente)
DESKTOP_LOG_LEVEL=info

# Modelo Gemini (opcional — boot only; API key via UI Configuracoes > API ou Provedores IA)
# gemini-2.0-flash e gemini-2.0-flash-lite foram descontinuados; modelos estaveis atuais:
#   gemini-2.5-flash (melhor custo-beneficio, recomendado)
#   gemini-2.5-flash-lite (mais rapido e economico)
#   gemini-2.5-pro (mais avancado)
GEMINI_MODEL=gemini-2.5-flash

# Feature flags por ambiente (opcional — precedencia sobre settings.json no boot)
# cloud | local | hybrid
FEATURE_PROVIDER_MODE=cloud
# true | false
FEATURE_LOCAL_PROVIDER_ENABLED=false
# true | false
FEATURE_FORCE_LOCAL_ONLY=false
# off | safe | strict — tambem afeta content protection do overlay de traducao (G5)
FEATURE_STEALTH_HARDENING=safe

# Runtime local (opcional)
# LLAMA_SERVER_PATH=
# WHISPER_CLI_PATH=
# FFMPEG_PATH=                 # caminho absoluto para ffmpeg.exe com demuxer WASAPI
# FFMPEG_DOWNLOAD_URL=         # default: BtbN win64-gpl (essentials do Gyan NÃO tem WASAPI)
# Modelo Whisper (default: ggml-base multilíngue no Hugging Face — baixe pela UI Configurações > Tradução)
# WHISPER_MODEL_PATH=
# WHISPER_MODEL_URL=
# WHISPER_MODEL_SHA256=
# WHISPER_SMALL_MODEL_PATH=
# WHISPER_SMALL_MODEL_URL=
# GEMINI_API_KEY=   # preferir salvar pela UI (criptografado no userData)
